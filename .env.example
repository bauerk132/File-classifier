# GEMINI_API_KEY: Optional Gemini API key if using Google AI.
# AI Studio automatically injects this if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AZURE_AI_API_KEY: Your Azure AI / Azure OpenAI API Key.
# Provide your Azure key here or in Settings > Secrets to use Azure AI as your primary analysis provider.
AZURE_AI_API_KEY=""

# AZURE_AI_ENDPOINT: The endpoint URL for your Azure AI / Azure OpenAI resource.
# Examples:
# - Azure OpenAI: https://<my-resource>.openai.azure.com/
# - Azure AI Foundry / Model Inference: https://<my-resource>.services.ai.azure.com/models
AZURE_AI_ENDPOINT=""

# AZURE_AI_DEPLOYMENT_NAME: The model or deployment name in Azure (e.g. gpt-4o, gpt-4o-mini, phi-4, etc.)
AZURE_AI_DEPLOYMENT_NAME="gpt-4o-mini"

# AZURE_AI_API_VERSION: The Azure OpenAI REST API version.
AZURE_AI_API_VERSION="2024-08-01-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

